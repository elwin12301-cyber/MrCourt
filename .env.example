# Copy this file to backend/.env (the backend reads .env from the folder it is started in) and fill in what you use.
# Names only: never commit real values. Anything left empty keeps that feature off or on its development fallback.

# --- Core ---------------------------------------------------------------------------------------------------
# PostgreSQL from `docker compose up -d db` (port 5432, or 5433 with MRCOURT_DB_PORT=5433). Use 127.0.0.1, not localhost.
DATABASE_URL=postgresql+psycopg://mrcourt:mrcourt@127.0.0.1:5432/mrcourt
ENVIRONMENT=development
# Required when ENVIRONMENT=production: signs session cookies
SESSION_SECRET=
# false for http://localhost; true in production (HTTPS only cookies)
COOKIE_SECURE=false
# Public address(es) of the frontend, comma separated (cross-origin write protection)
ALLOWED_ORIGINS=http://localhost:5173
PUBLIC_APP_URL=http://localhost:5173
# Production only: the built website served by the API (frontend/dist)
FRONTEND_DIST=
SESSION_MAX_AGE_SECONDS=43200

# --- Answers (use one: Anthropic, or the free Gemini key) -----------------------------------------------------
ANTHROPIC_API_KEY=
ANSWER_MODEL=claude-sonnet-5-5
ASSISTANT_MODEL=
ASSISTANT_MAX_STEPS=6
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# --- Meaning-based search (Voyage AI) and ranking -------------------------------------------------------------
VOYAGE_API_KEY=
EMBEDDING_MODEL=voyage-3.5
RERANK_MODEL=rerank-2.5
MIN_RERANK_SCORE=0.5
MIN_RERANK_SCORE_KEYWORD=0.45
MIN_VECTOR_SCORE=0.2
MIN_RETRIEVAL_SCORE=0.3
RERANK_CANDIDATES=20
# hybrid (default) or rrf (the earlier ordering, kept as a rollback)
RANKING_MODE=hybrid
RANK_W_KEYWORD=0.10
RANK_W_MEANING=0.0
RANK_W_RERANK=0.90
RANK_BOOST_SECTION=0.25
RANK_BOOST_TYPE=0.10
RANK_BOOST_COURT=0.08
RANK_BOOST_OWN_CASE=0.15
RANK_RECENCY_MAX=0.05
RANK_PER_DOCUMENT=2

# --- Speech to text for Indian languages (also the opt-in cloud option of voice control) ---------------------------
SARVAM_API_KEY=
STT_MODEL=saaras:v4

# --- Uploads, scans and the knowledge base ---------------------------------------------------------------------
UPLOAD_DIR=uploads
MAX_UPLOAD_BYTES=15728640
KNOWLEDGE_DIR=knowledge
MAX_KNOWLEDGE_BYTES=10485760
MAX_KNOWLEDGE_PAGES=600
# Tesseract language packs (the program must be installed separately)
OCR_LANGUAGES=eng+tam
MAX_OCR_PAGES=60

# --- Sign-in codes and text messages ---------------------------------------------------------------------------
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
LOGIN_ATTEMPTS_PER_WINDOW=10
SMS_COUNTRY_CODE=91
# Fast2SMS (Indian SMS; a wallet balance is needed). Quick SMS is used unless the OTP route is verified.
FAST2SMS_API_KEY=
FAST2SMS_OTP_ROUTE=false
# Twilio (SMS, and the free WhatsApp sandbox)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=
# Hearing reminders inside the app: minutes between runs (0 = off; use an outside scheduler instead)
REMINDER_INTERVAL_MINUTES=0

# --- WhatsApp channel (none, fast2sms, twilio or meta) ---------------------------------------------------------
WHATSAPP_PROVIDER=none
WHATSAPP_WEBHOOK_URL=
WHATSAPP_DAILY_SEND_CAP=500
WHATSAPP_NUDGE_DELAY_SECONDS=180
WHATSAPP_QUESTIONS_PER_MINUTE=3
WHATSAPP_QUESTIONS_PER_DAY=40
# Fast2SMS WhatsApp: the connected number's id, the Message IDs of the approved templates, the webhook secret
FAST2SMS_WHATSAPP_PHONE_NUMBER_ID=
FAST2SMS_WHATSAPP_TEMPLATE_CODE=
FAST2SMS_WHATSAPP_TEMPLATE_REMINDER=
FAST2SMS_WHATSAPP_TEMPLATE_UPDATE=
FAST2SMS_WHATSAPP_TEMPLATE_ACTIVITY=
FAST2SMS_WEBHOOK_SECRET=
# Meta WhatsApp Business
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_TEMPLATE_CODE=mrcourt_code
WHATSAPP_TEMPLATE_REMINDER=mrcourt_hearing_reminder
WHATSAPP_TEMPLATE_UPDATE=mrcourt_case_update
WHATSAPP_TEMPLATE_ACTIVITY=mrcourt_activity
