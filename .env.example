# Copy to .env and fill in. Never commit real values.
DATABASE_URL=postgresql+psycopg://mrcourt:mrcourt@localhost:5432/mrcourt
SESSION_SECRET=
ANTHROPIC_API_KEY=
EMBEDDING_API_KEY=
SMS_PROVIDER_API_KEY=
WHATSAPP_PROVIDER_API_KEY=
